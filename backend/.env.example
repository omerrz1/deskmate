# API keys are entered in the app (a setup wizard asks for OpenAI, then ElevenLabs) and stored encrypted.
# Keys left here are moved into the app the first time the original workspace starts.
OPENAI_API_KEY=
# Best quality/latency for Arabic, Hindi, Urdu, Bengali, Chinese etc.
CHAT_MODEL=gpt-4.1
STT_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
# marin / cedar / coral / sage are the most natural
AGENT_VOICE=marin
# COMPANY_NAME=   (optional: set your company name and details in the app instead, under Settings → Company)
AGENT_NAME=Maya
# Optional: ElevenLabs for the most realistic speech (set both to enable)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4_turbo
# Agents use full eleven_v4 (most emotive, ~1s slower per reply). For faster replies: ELEVENLABS_AGENT_TTS=eleven_v4_turbo
# Live phone voice (speech-to-speech): gpt-realtime-2.1, gpt-realtime or gpt-realtime-mini (cheaper)
REALTIME_MODEL=gpt-realtime-2.1

# ---- NATIVE-SPEAKER VOICES for Arabic / Hindi / Urdu / Bengali / Asian languages (set ONE provider) ----
# Option A: Azure Speech (official, cheap, free tier; ar/hi/ur/bn voices are native)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# AZURE_VOICE_AR=ar-SA-ZariyahNeural     # change dialect: ar-EG-SalmaNeural, ar-AE-FatimaNeural, ar-LB-LaylaNeural ...
# Option B: ElevenLabs (most expressive). Pick native voices in their voice library, then set the ids:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=            # default voice
# ELEVENLABS_VOICE_AR=  ELEVENLABS_VOICE_HI=  ELEVENLABS_VOICE_UR=  ELEVENLABS_VOICE_BN=

# ---- Security (see README) ----
# Origins allowed to call the API with the admin cookie (comma separated). Add your real domain in production.
# ALLOWED_ORIGINS=https://automation.example.com
# Set to true when served over HTTPS so the session cookie is only sent securely.
# COOKIE_SECURE=true
# Set to true ONLY behind a reverse proxy you control (reads the client IP from X-Forwarded-For for rate limits and the audit log).
# TRUSTED_PROXY=true
# SESSION_HOURS=12
# SESSION_IDLE_MINUTES=120

# ---- Many companies on one server (see README) ----
# SIGNUP_CODE=a-long-secret  (creating a company then needs this code; delete it to open sign-up again)
# SIGNUPS_OPEN=true                 # false closes public sign-up (existing companies keep working)
# MAX_WORKSPACES=1000               # most companies this server will hold
# MAX_AGENTS_PER_WORKSPACE=30       # most employees one company can create
# CONTACT_EMAIL=hello@yourdomain.com   # shown on the public Contact page; messages from its form are read under Settings -> Platform
