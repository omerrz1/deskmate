# Deskmates backend, production settings. setup.sh copies this to /etc/deskmate/backend.env the first time and never overwrites it afterwards.
# Do NOT put OpenAI or ElevenLabs keys here: each company enters its own in the app, and they are stored encrypted.

# Where the databases, files and the encryption key live (must be a persistent disk). The service sets this too.
DATA_DIR=/var/lib/deskmate

# The browser address people use. Requests from any other website are refused.
ALLOWED_ORIGINS=https://deskmate.londoncbs.uk

# We are served over HTTPS, so the session cookie is only ever sent securely.
COOKIE_SECURE=true

# We sit behind Caddy (and CloudFront), so read the visitor's address from X-Forwarded-For for the rate limits and the audit log.
TRUSTED_PROXY=true

# The public address of this API (used when checking webhook signatures).
PUBLIC_BASE_URL=https://api.deskmate.londoncbs.uk

# Can anyone create a company workspace? Set false once your own company exists if this is only for you.
SIGNUPS_OPEN=true

# Shown on the public contact page.
CONTACT_EMAIL=

# Optional limits (defaults are fine):
# MAX_WORKSPACES=1000
# MAX_USERS_PER_WORKSPACE=25
# SESSION_HOURS=12
# SESSION_IDLE_MINUTES=120
